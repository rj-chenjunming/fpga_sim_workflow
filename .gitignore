# ── 编排层运行时与虚拟环境（可重建，不入库）
loop/.venv/
loop/state/
loop/.logs/
loop/.pytest_cache/
loop/.agently/
loop/.browser-cache/

# ── Python 字节码
__pycache__/
*.pyc

# ── 运行时快照（spike 的一次性产物，不是源码）
loop/spikes/snap.json

# ── 本机夹具 worktree 缓存（外部工具创建：完整 repo 副本 + 冻结夹具，约 260 MB，可重建，不入库）
# 出现时 git status 会把它当未跟踪目录；它不是仓内产物，也不得提交。
.wt-fixtures/

# ---- 软件管理的每环境数据（体积大、属运行产物，不入库）----
# 当前 default 环境的数据仍在 ENV_ROOT/kb（见 environments.json）；
# 若将来把数据迁入 workspaces/<env-id>/，本规则保证它不入库。
workspaces/*/
!workspaces/.gitkeep
!workspaces/README.md

# ── 本机演示/派生数据根（运行产物，可重建，不入库；本机已在 .git/info/exclude 中重复一份）
.dev-ws*/
.demo-ws/
.env-copy/
.s0-*/
.pw-browsers/
.chrome-home*/
.chrome-tmp*/

# ── 凭据库/密钥：任何位置都不得入库（DSH 凭据库含宿主 api-key；S8h 裁决 A 后它会落在 DSH_HOME）
.credentials.yaml
.credentials.yml
*.credentials.yaml
