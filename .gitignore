# ── 编排层运行时与虚拟环境（可重建，不入库）
loop/.venv/
loop/state/
loop/.logs/
loop/.pytest_cache/
loop/.agently/

# ── Python 字节码
__pycache__/
*.pyc

# ── 运行时快照（spike 的一次性产物，不是源码）
loop/spikes/snap.json

# ---- 软件管理的每环境数据（体积大、属运行产物，不入库）----
# 当前 default 环境的数据仍在 ENV_ROOT/kb（见 environments.json）；
# 若将来把数据迁入 workspaces/<env-id>/，本规则保证它不入库。
workspaces/*/
!workspaces/.gitkeep
!workspaces/README.md
