+    print("[kb] 台账：%s（追加 %d 条 overrides 记录，record_sha256 可离线复算）"
+          % (K.relpath(p), len(planned)))
+    print("[kb] 时间字段声明：decided_at/updated_at（README §3.1.1，--now/KB_NOW 注入）")
+    return RC_OK
